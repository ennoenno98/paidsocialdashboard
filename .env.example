# Copy to .env (gitignored). Secrets only via env / GitHub Actions secrets.

# Workbook (default: data/Social_Media.xlsx; falls back to the fixture when absent)
SOCIAL_XLSX=data/Social_Media.xlsx

# --- Klar ---------------------------------------------------------------------
KLAR_API_KEY=
KLAR_SHOP_ID=
# Endpoint config, to be filled from the Klar Public API technical docs (help.getklar.com -> "Klar Public API").
# The client raises NotImplementedError until KLAR_INFLUENCER_REPORT_PATH is set.
KLAR_API_BASE_URL=https://api.getklar.com
KLAR_INFLUENCER_REPORT_PATH=
KLAR_REQUEST_STYLE=post_json
# Alternative: a CSV export of the influencer_flex report from the Klar UI
KLAR_CSV_EXPORT=
# Klar influencer Google Sheets (campaign master; Reach column = creator reach). JSON brand -> published CSV url.
# KLAR_SHEET_CSV_URLS={"vegavero": "https://docs.google.com/spreadsheets/d/<id>/export?format=csv", "wowtamins": "..."}
# KLAR_SHEETS_DIR=data/raw/klar_sheets

# --- Team input sheet (Google Sheet "Social dashboard – manual inputs") -------
# One published-CSV link per tab (File -> Share -> Publish to web -> tab -> CSV). Tabs: creator_reach, stories,
# tiktok_weekly, budget. `make refresh` downloads them into INPUT_SHEET_DIR.
# INPUT_SHEET_CSV_URLS={"creator_reach": "https://docs.google.com/spreadsheets/d/e/<pub-id>/pub?gid=<gid>&single=true&output=csv", "stories": "...", "tiktok_weekly": "...", "budget": "..."}
# INPUT_SHEET_DIR=data/raw/input_sheet

# --- Instagram Graph API (Meta app) -------------------------------------------
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# JSON: canonical account key -> IG business account id
IG_BUSINESS_ACCOUNT_IDS={"vegavero/instagram/IT": "", "vegavero/instagram/DE": "", "wowtamins/instagram/DE": "", "jasnum/instagram/IT": ""}

# --- Windsor.ai (primary source for Instagram organic, Meta boosts, creator public counts) ---
WINDSOR_API_KEY=
# WINDSOR_API_BASE_URL=https://connectors.windsor.ai
# WINDSOR_RAW_DIR=data/raw/windsor      # cache of raw pulls (JSON per pull)
