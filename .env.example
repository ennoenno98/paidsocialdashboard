# Copy to .env (gitignored). Secrets only via env / GitHub Actions secrets.

# Workbook (default: data/Social_Media.xlsx; falls back to the fixture when absent)
SOCIAL_XLSX=data/Social_Media.xlsx

# --- Klar ---------------------------------------------------------------------
KLAR_API_KEY=
KLAR_SHOP_ID=
# Endpoint config, to be filled from the Klar Public API technical docs (help.getklar.com -> "Klar Public API").
# The client raises NotImplementedError until KLAR_INFLUENCER_REPORT_PATH is set.
KLAR_API_BASE_URL=https://api.getklar.com
KLAR_INFLUENCER_REPORT_PATH=
KLAR_REQUEST_STYLE=post_json
# Alternative: a CSV export of the influencer_flex report from the Klar UI
KLAR_CSV_EXPORT=

# --- Instagram Graph API (Meta app) -------------------------------------------
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
# JSON: canonical account key -> IG business account id
IG_BUSINESS_ACCOUNT_IDS={"vegavero/instagram/IT": "", "vegavero/instagram/DE": "", "wowtamins/instagram/DE": "", "jasnum/instagram/IT": ""}

# --- Windsor.ai alternative (instagram_public connector) ----------------------
WINDSOR_API_KEY=
WINDSOR_IG_FIELDS=
